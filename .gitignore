# Fichiers générés automatiquement par Python
__pycache__/
*.pyc
.pytest_cache/

# État local de Lidar Plot (dernière session ouverte sur ce PC)
data/.derniere_session

# Fichiers temporaires de Word / Excel ouverts
~$*

# Identifiants Wi-Fi personnels du robot (ne jamais les committer)
arduino/**/wifi_secrets.h


# Archives produites pour le rendu (copies des dépôts, pas des sources)
rendu/archives/
